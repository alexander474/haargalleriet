RewriteEngine On
RewriteBase /

# Don't redirect /about to /about/ (pages are prerendered as about/index.html)
DirectorySlash Off

# Set correct MIME types
AddType application/xml .xml
AddType text/plain .txt

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Redirect non-www to www
RewriteCond %{HTTP_HOST} ^haargallerietfagernes\.no [NC]
RewriteRule ^(.*)$ https://www.haargallerietfagernes.no/$1 [L,R=301]

# Prerendered pages: /about -> /about/index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Everything else (unknown routes) -> client-rendered Angular shell
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.csr.html [L]
